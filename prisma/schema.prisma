generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model Application {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  company         String   @db.NVarChar(255)
  role            String   @db.NVarChar(255)
  status          String   @default("Draft") @db.VarChar(50)

  postUrl         String?  @db.NVarChar(2000)
  jobDescription  String?  @db.NVarChar(Max)
  techStack       String?  @db.NVarChar(1000)

  fitScore        Int?
  aiAnalysis      String?  @db.NVarChar(Max)

  appliedDate     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  interviews      Interview[] // <--- This is the missing link!

  @@map("applications")
}

model Interview {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  applicationId   String   @db.UniqueIdentifier

  // Ensure this field exists
  status          String   @default("Scheduled") @db.VarChar(50)

  round           Int
  type            String   @db.VarChar(100)
  scheduledFor    DateTime
  notes           String?  @db.NVarChar(Max)

  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("interviews")
}

model ResumeVariant {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  name            String   @db.NVarChar(255) // e.g., "Data Science Focus"
  filePath        String?  @db.NVarChar(1000)
  notes           String?  @db.NVarChar(Max)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("resume_variants")
}