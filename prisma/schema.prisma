generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model Application {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  company         String   @db.NVarChar(255)
  role            String   @db.NVarChar(255)
  status          String   @default("Draft") @db.VarChar(50)

  postUrl         String?  @db.NVarChar(2000)
  jobDescription  String?  @db.NVarChar(Max)
  techStack       String?  @db.NVarChar(1000)

  fitScore        Int?
  aiAnalysis      String?  @db.NVarChar(Max)

  appliedDate     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  interviews      Interview[]

  resumeId        String?      @db.UniqueIdentifier
  resume          ResumeVariant? @relation(fields: [resumeId], references: [id])

  @@map("applications")
}

model Interview {
  id                  String   @id @default(uuid()) @db.UniqueIdentifier
  applicationId       String   @db.UniqueIdentifier

  status              String   @default("Scheduled") @db.VarChar(50)
  round               Int
  type                String   @db.VarChar(100)
  scheduledFor        DateTime
  notes               String?  @db.NVarChar(Max)

  // --- Analytics & Coach Fields ---
  stumpers            String?  @db.NVarChar(Max) // Can store comma-separated questions or JSON
  bridgeEffectiveness Int?     // 1-5 rating

  application         Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("interviews")
}

model ResumeVariant {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  name            String   @db.NVarChar(255)
  filePath        String?  @db.NVarChar(1000)
  notes           String?  @db.NVarChar(Max)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications    Application[]

  @@map("resume_variants")
}

model MasterStory {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  title       String   @db.NVarChar(255) // e.g., "Tell me about a time you failed"
  category    String   @db.VarChar(100)  // e.g., "Leadership", "Conflict", "Technical Challenge"

  // The STAR Method Breakdown
  situation   String   @db.NVarChar(Max)
  task        String   @db.NVarChar(Max)
  action      String   @db.NVarChar(Max)
  result      String   @db.NVarChar(Max)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("master_stories")
}